# All values are optional; these are the defaults. No secrets are required.
BORDERSCORE_HOME=./artifacts
# MLFLOW_TRACKING_URI defaults to sqlite:///<BORDERSCORE_HOME>/mlflow.db
# MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
MLFLOW_EXPERIMENT_NAME=borderscore
BORDERSCORE_SEED=42
BORDERSCORE_N_SOURCE=6000
BORDERSCORE_N_NEW=400
BORDERSCORE_N_HOLDOUT=4000
# Promotion gate margins (challenger must beat champion by more than these)
BORDERSCORE_GATE_MIN_AUC_GAIN=0.0
BORDERSCORE_GATE_MIN_ECE_GAIN=0.0
# Airflow only: cron string, empty = manual trigger
BORDERSCORE_SCHEDULE=
